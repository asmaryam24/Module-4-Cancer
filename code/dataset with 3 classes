# %%
#classification 

# load validation data
validation_data = pd.read_csv(
    r'C:\Users\Asma Sanaullah\OneDrive - University of Virginia\Spring 2026\COMP BME\Module-4-Cancer\data\VALIDATION_SET_GSE62944_subsample_log2TPM.csv',
    index_col=0,
    header=0
)

validation_metadata = pd.read_csv(
    r'C:\Users\Asma Sanaullah\OneDrive - University of Virginia\Spring 2026\COMP BME\Module-4-Cancer\data\VALIDATION_SET_GSE62944_metadata.csv',
    index_col=0,
    header=0
)

validation_samples = validation_metadata.index

validation_metadata["class_label"] = validation_metadata["cancer_type"].apply(
    lambda x: x if x in ["GBM", "LGG"] else "Neither"
)

# subset expression data
validation_subset = validation_data[validation_samples]

# keep only genes of interest
validation_gene_data = validation_subset.loc[gene_list]

# transpose so rows = samples (IMPORTANT)
validation_gene_data_T = validation_gene_data.T

# merge with metadata
validation_merged_df = validation_gene_data_T.merge(
    validation_metadata.loc[validation_samples],
    left_index=True,
    right_index=True
)

# training data
X_train = merged_df[gene_list]
y_train = merged_df["class_label"]

# build and fit a logistic regression model
model = LogisticRegression(
    penalty=None,
    max_iter=1000,
    multi_class="multinomial"
)
model.fit(X_train, y_train)

# PREDICT AND EVALUATE: 
X_valid = validation_merged_df[gene_list]
y_valid = validation_merged_df["class_label"]

#predict target variables for the validation set
y_pred = model.predict(X_valid)
#evaluate the model's performance on the validation set
model.score(X_valid, y_valid)
print("Validation Accuracy:", model.score(X_valid, y_valid))

#compare predicted labels to true labels
print("Predicted labels for validation set:", y_pred)
print("True labels for validation set:", y_valid.values)

